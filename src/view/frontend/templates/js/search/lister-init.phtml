<?php

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Tweakwise\TweakwiseJs\Model\Enum\SearchType;
use Tweakwise\TweakwiseJs\ViewModel\Search;

/** @var Template $block */
/** @var Escaper $escaper */

/** @var Search $viewModel */
$viewModel = $block->getViewModel();
$cid = (string) $viewModel->getStoreRootCategory();
$language = (string) $viewModel->getLanguage();
$uiLanguage = (string) $viewModel->getUiLanguage();
?>

<div id="tweakwise-output"></div>

<?php if ($viewModel->getSearchType() === SearchType::INSTANT_SEARCH): ?>
    <?php return; ?>
<?php endif; ?>

<script>
    window.tweakwiseJs.onReady(() => {
        window.tweakwiseListerPage({
            query: window.tweakwiseJs.getSearchTerm(),
            cid: '<?= $escaper->escapeJs($cid) ?>',
            <?php if ($language !== ''): ?>
                lang: '<?= $escaper->escapeJs($language) ?>',
            <?php endif; ?>
            ui: {
                <?php if ($uiLanguage !== ''): ?>
                    lang: '<?= $escaper->escapeJs($uiLanguage) ?>',
                <?php endif; ?>
                closeSearchButton: false
            },
            output: '#tweakwise-output',
            on: window.tweakwiseJs.addToHandlers
        });
    });
</script>
<?php if (isset($hyvaCsp)) { $hyvaCsp->registerInlineScript();} ?>
