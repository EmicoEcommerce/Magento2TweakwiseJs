<?php

declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Tweakwise\TweakwiseJs\ViewModel\Base;

/** @var Template $block */
/** @var Base $viewModel */
$viewModel = $block->getViewModel();
if (!$viewModel->isEnabled() || !$viewModel->getInstanceKey() || !$viewModel->isEventsEnabled()) {
    return;
}
?>
<script>
    (() => {
        let lastSearchTerm;
        const trackSearch = (term = window.tweakwiseJs.getSearchTerm()) => {
            if (term === lastSearchTerm) {
                return;
            }

            lastSearchTerm = term;
            if (!term) {
                return;
            }

            pushEvent({
                event: 'search',
                data: {
                    profileKey: getProfileKey(),
                    searchTerm: term
                }
            });
        };

        window.addEventListener('hashchange', () => trackSearch());
        window.addEventListener('popstate', () => trackSearch());
        window.addEventListener('twn.selection.change', event => {
            if (typeof event.detail?.data?.tn_q === 'string') {
                trackSearch(event.detail.data.tn_q);
            }
        });
        trackSearch();
    })();
</script>
<?php if (isset($hyvaCsp)) { $hyvaCsp->registerInlineScript();} ?>
