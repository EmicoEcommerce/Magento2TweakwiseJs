<?php

declare(strict_types = 1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Tweakwise\TweakwiseJs\Model\Enum\SearchType;
use Tweakwise\TweakwiseJs\ViewModel\Search;

/** @var Template $block */
/** @var Escaper $escaper */

/** @var Search $viewModel */
$viewModel = $block->getViewModel();
if (!$viewModel->isEnabled() || !$viewModel->getInstanceKey()) {
    return;
}

$language = (string) $viewModel->getLanguage();
$uiLanguage = (string) $viewModel->getUiLanguage();
$instanceKey = (string) $viewModel->getInstanceKey();
$cid = (string) $viewModel->getStoreRootCategory();
$searchType = $viewModel->getSearchType();
?>

<?php if ($searchType === SearchType::SUGGESTIONS): ?>
    <script>
        window.tweakwiseJs.initSuggestions({
            instancekey: '<?= $escaper->escapeJs($instanceKey) ?>',
            cid: '<?= $escaper->escapeJs($cid) ?>',
            <?php if ($language !== ''): ?>
                lang: '<?= $escaper->escapeJs($language) ?>',
            <?php endif; ?>
            <?php if ($uiLanguage !== ''): ?>
                ui: {
                    lang: '<?= $escaper->escapeJs($uiLanguage) ?>'
                },
            <?php endif; ?>
        }, '<?= $escaper->escapeJs($viewModel->getSearchUrl()) ?>');
    </script>
    <?php if (isset($hyvaCsp)) { $hyvaCsp->registerInlineScript(); } ?>
<?php elseif ($searchType === SearchType::INSTANT_SEARCH): ?>
    <script>
        window['twn-starter-config'].auto = true;
        window['twn-starter-config'].cid = '<?= $escaper->escapeJs($cid) ?>';
        <?php if ($language !== ''): ?>
            window['twn-starter-config'].lang = '<?= $escaper->escapeJs($language) ?>';
        <?php endif; ?>
        window['twn-starter-config'].ui = window['twn-starter-config'].ui || {};
        <?php if ($uiLanguage !== ''): ?>
            window['twn-starter-config'].ui.lang = '<?= $escaper->escapeJs($uiLanguage) ?>';
        <?php endif; ?>
        <?php if ($viewModel->isSearchResultsPage()): ?>
            window['twn-starter-config'].ui.closeSearchButton = false;
            window['twn-starter-config'].output = '#tweakwise-output';
            window['twn-starter-config'].query = window.tweakwiseJs.getSearchTerm();
        <?php endif; ?>
        window['twn-starter-config'].on = Object.assign(
            window['twn-starter-config'].on || {},
            window.tweakwiseJs.addToHandlers
        );
        window.tweakwiseJs.onDomReady(() => {
            const form = document.getElementById('search_mini_form');
            if (!form) {
                return;
            }

            form.removeAttribute('@submit.prevent');
            form.onsubmit = event => event.preventDefault();
        });
    </script>
    <?php if (isset($hyvaCsp)) { $hyvaCsp->registerInlineScript(); } ?>
<?php else: ?>
    <script>
        window['twn-starter-config'].input = null;
    </script>
    <?php if (isset($hyvaCsp)) { $hyvaCsp->registerInlineScript(); } ?>
<?php endif; ?>
